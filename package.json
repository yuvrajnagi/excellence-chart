{
  "name": "openexcel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bash scripts/run.sh dev",
    "test": "bash scripts/run.sh test",
    "typecheck": "bash scripts/run.sh typecheck",
    "build": "bash scripts/run.sh build",
    "test:e2e": "bash scripts/run.sh test:e2e",
    "benchmark": "bash scripts/run.sh benchmark",
    "samples": "bash scripts/run.sh samples",
    "start": "node apps/server/dist/index.js"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.55.1",
    "@types/node": "24.10.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "fast-check": "4.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-language-server": "5.1.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
